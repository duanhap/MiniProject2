<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    tools:context=".TicketActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/toolbar_bg"
        app:title="@string/ticket_title"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/white" />

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- TICKET CARD (White) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="12dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Ticket Header (gradient red → navy) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:background="@drawable/bg_ticket_header"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="20dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_ticket"
                            app:tint="@color/white" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CineBook"
                                android:textColor="#80FFFFFF"
                                android:textSize="12sp"
                                android:letterSpacing="0.1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vé Điện Tử"
                                android:textColor="@color/white"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Booking ID chip -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#30FFFFFF"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MÃ VÉ"
                                android:textColor="#AAFFFFFF"
                                android:textSize="9sp"
                                android:letterSpacing="0.1" />

                            <TextView
                                android:id="@+id/tvBookingId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="CB-20250327" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Dashed Perforation Divider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Left circle cutout -->
                        <View
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@color/bg_dark" />

                        <!-- Dashed line -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/ticket_separator" />

                        <!-- Right circle cutout -->
                        <View
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@color/bg_dark" />
                    </LinearLayout>

                    <!-- Ticket Body -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Movie Row -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="16dp">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/ticket_movie_label" style="@style/TextAppearance.Cinema.TicketLabel"/>
                                <TextView android:id="@+id/tvTicketMovie" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" style="@style/TextAppearance.Cinema.TicketValue"
                                    android:layout_marginTop="3dp" tools:text="Avengers: Endgame"/>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Theater Row -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="16dp">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/ticket_theater_label" style="@style/TextAppearance.Cinema.TicketLabel"/>
                                <TextView android:id="@+id/tvTicketTheater" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" style="@style/TextAppearance.Cinema.TicketValue"
                                    android:layout_marginTop="3dp" tools:text="CGV Vincom Center"/>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Time + Seat Row (2 columns) -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:layout_marginBottom="16dp">

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/ticket_time_label" style="@style/TextAppearance.Cinema.TicketLabel"/>
                                <TextView android:id="@+id/tvTicketTime" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" style="@style/TextAppearance.Cinema.TicketValue"
                                    android:layout_marginTop="3dp" tools:text="09:30 — 27/03/2025"/>
                            </LinearLayout>

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/ticket_seat_label" style="@style/TextAppearance.Cinema.TicketLabel"/>
                                <TextView android:id="@+id/tvTicketSeats" android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" style="@style/TextAppearance.Cinema.TicketValue"
                                    android:textColor="@color/cinema_red"
                                    android:layout_marginTop="3dp" tools:text="A1, A2"/>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Price Row (highlighted) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#0DE53935"
                            android:padding="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/ticket_price_label" style="@style/TextAppearance.Cinema.TicketLabel"/>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvTicketPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/cinema_red"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                tools:text="240.000 đ" />
                        </LinearLayout>

                        <!-- QR Code Placeholder -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="20dp">

                            <ImageView
                                android:id="@+id/ivQrCode"
                                android:layout_width="@dimen/ticket_qr_size"
                                android:layout_height="@dimen/ticket_qr_size"
                                android:src="@android:drawable/ic_menu_share"
                                android:background="#F5F5F5"
                                android:padding="16dp"
                                android:scaleType="fitCenter" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Quét mã tại quầy"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp"
                                android:layout_marginTop="8dp" />
                        </LinearLayout>

                        <!-- Enjoy message -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:text="@string/ticket_enjoy"
                            android:textColor="@color/ticket_text_dark"
                            android:textSize="13sp"
                            android:paddingTop="16dp"
                            android:paddingBottom="4dp" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownloadTicket"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/btn_download"
                    android:textColor="@color/white"
                    android:layout_marginEnd="8dp"
                    app:strokeColor="@color/cinema_red"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareTicket"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/btn_share"
                    android:layout_marginStart="8dp"
                    app:backgroundTint="@color/cinema_red"
                    app:cornerRadius="12dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
